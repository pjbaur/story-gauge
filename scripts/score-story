#!/usr/bin/env bash
# score-story — score one markdown story/spec against the sizing gates.
# Usage: score-story <story.md> [--quiet] [--format table|json] [--config FILE] [--llm]
# Exit:  0 = READY (no gate tripped) | 1 = SPLIT (>=1 tripped) | 2 = usage error
set -euo pipefail

# Resolve real script dir even when invoked through a symlink (install.sh links to PATH).
SRC="${BASH_SOURCE[0]}"
while [ -h "$SRC" ]; do
  D="$(cd -P "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"
  [ "${SRC#/}" = "$SRC" ] && SRC="$D/$SRC"
done
HERE="$(cd -P "$(dirname "$SRC")" && pwd)"
# shellcheck source=./scripts/sizer.sh
source "$HERE/sizer.sh"

usage() {
  echo "usage: score-story <story.md> [--quiet] [--format table|json] [--config FILE] [--llm] [--llm-provider NAME] [--llm-model MODEL] [--llm-timeout SECONDS] [--llm-fail-policy advisory|high-confidence|strict]" >&2
}

QUIET=0; FORMAT="table"; FILE=""; LLM=0
LLM_PROVIDER_ARG=""; LLM_MODEL_ARG=""; LLM_TIMEOUT_ARG=""; LLM_FAIL_POLICY_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --quiet) QUIET=1 ;;
    --json) FORMAT="json" ;;
    --format)
      shift
      [ $# -gt 0 ] || { usage; exit 2; }
      FORMAT="$1"
      case "$FORMAT" in table|json) ;; *) echo "unknown format: $FORMAT" >&2; exit 2 ;; esac
      ;;
    --config)
      shift
      [ $# -gt 0 ] || { usage; exit 2; }
      export STORY_GAUGE_CONFIG="$1"
      ;;
    --llm) LLM=1 ;;
    --llm-provider)
      shift
      [ $# -gt 0 ] || { usage; exit 2; }
      LLM_PROVIDER_ARG="$1"
      ;;
    --llm-model)
      shift
      [ $# -gt 0 ] || { usage; exit 2; }
      LLM_MODEL_ARG="$1"
      ;;
    --llm-timeout)
      shift
      [ $# -gt 0 ] || { usage; exit 2; }
      LLM_TIMEOUT_ARG="$1"
      ;;
    --llm-fail-policy)
      shift
      [ $# -gt 0 ] || { usage; exit 2; }
      LLM_FAIL_POLICY_ARG="$1"
      ;;
    -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)
      [ -z "$FILE" ] || { echo "unexpected arg: $1" >&2; exit 2; }
      FILE="$1"
      ;;
  esac
  shift
done
[ -z "$FILE" ] && { usage; exit 2; }
[ -f "$FILE" ] || { echo "no such file: $FILE" >&2; exit 2; }

sizer_load_config
[ -n "$LLM_PROVIDER_ARG" ] && LLM_PROVIDER="$LLM_PROVIDER_ARG"
[ -n "$LLM_MODEL_ARG" ] && LLM_MODEL="$LLM_MODEL_ARG"
[ -n "$LLM_TIMEOUT_ARG" ] && LLM_TIMEOUT_SECONDS="$LLM_TIMEOUT_ARG"
[ -n "$LLM_FAIL_POLICY_ARG" ] && LLM_FAIL_POLICY="$LLM_FAIL_POLICY_ARG"
sizer_validate_config
sizer_score_file "$FILE" || { echo "missing required section: $(sizer_hashes "$AC_LEVEL") $AC_HEADING" >&2; exit 2; }

score_json=$(sizer_score_json_object "$FILE")
semantic_json=""
if [ "$LLM" -eq 1 ]; then
  if ! semantic_json=$("$HERE/llm-review-gates" "$FILE" \
      --score-json "$score_json" \
      --provider "$LLM_PROVIDER" \
      --model "$LLM_MODEL" \
      --timeout "$LLM_TIMEOUT_SECONDS" \
      --context-max-chars "$LLM_CONTEXT_MAX_CHARS"); then
    semantic_json=$(sizer_semantic_unavailable_json "semantic review unavailable: helper failed")
  fi
fi

if [ "$QUIET" -eq 0 ]; then
  case "$FORMAT" in
    table)
      row() { # label value max
        local st="OK  "; [ "$2" -gt "$3" ] && st="FAIL"
        printf '  %-24s %4s   %s (max %s)\n' "$1" "$2" "$st" "$3"
      }
      echo "STORY SIZING SCORE - $(basename "$FILE")"
      echo "----------------------------------------------"
      row "1 ACs"             "$ACS"  "$MAX_ACS"
      row "2 files (logic)"   "$FILES" "$MAX_FILES"
      row "3 state-machine hits~" "$SM" "$MAX_SM"
      row "4 markers"         "$MARK" "$MAX_MARKERS"
      row "5 race/lifecycle"  "$RACE" "$MAX_RACE"
      printf '  %-24s %4s   (warn >%s)\n' "  dev-notes lines" "$DEVLINES" "$WARN_DEVNOTES_LINES"
      echo "----------------------------------------------"
      case "$TRIP" in
        0) echo "VERDICT: READY   (0 gates tripped)" ;;
        1) echo "VERDICT: SPLIT   (1 gate tripped)" ;;
        *) echo "VERDICT: SPLIT   ($TRIP gates tripped - HIGH)" ;;
      esac
      if [ "$LLM" -eq 1 ]; then
        sizer_print_semantic_table "$semantic_json" "$LLM_FAIL_POLICY"
      fi
      ;;
    json)
      if [ "$LLM" -eq 1 ]; then
        sizer_json_merge_objects "$score_json" "$semantic_json"
      else
        printf '%s' "$score_json"
      fi
      printf '\n'
      ;;
  esac
fi

if [ "$LLM" -eq 1 ] && sizer_semantic_should_fail "$semantic_json" "$LLM_FAIL_POLICY" "$LLM_CONFIDENCE_THRESHOLD"; then
  exit 1
fi
[ "$TRIP" -eq 0 ]
